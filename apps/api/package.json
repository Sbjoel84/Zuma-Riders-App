{
  "name": "@zuma/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/websockets": "^11.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@zuma/contracts": "workspace:*",
    "@zuma/database": "workspace:*",
    "bullmq": "^5.30.0",
    "dotenv": "^16.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.9.0",
    "@swc/jest": "^0.2.37",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.0",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.0",
    "supertest": "^7.0.0",
    "typescript": "^5.9.0",
    "pg": "^8.13.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0"
  }
}