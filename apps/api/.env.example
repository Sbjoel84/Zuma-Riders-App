NODE_ENV=development
PORT=4000
# Neon pooled connection string in staging/production
DATABASE_URL=postgresql://zuma:zuma@localhost:5432/zuma_dev
REDIS_URL=redis://localhost:6379
# Generate each with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
OTP_SECRET=change-me-change-me-change-me-change-me
TRIP_PIN_SECRET=change-me-change-me-change-me-change-me
# console prints OTPs to the API log (dev only). Use termii in staging/production.
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=Zuma
# estimate = straight line x 1.35 (dev only). Use google in staging/production.
MAPS_PROVIDER=estimate
GOOGLE_MAPS_API_KEY=
WORKER_ENABLED=true
MATCH_EXPAND_AFTER_S=15
EARNINGS_HOLD_S=86400
DRIVER_NEGATIVE_LIMIT_KOBO=500000
CORS_ORIGINS=*

# Public URL of this API (fake checkout, local uploads and trip-share links point here).
PUBLIC_API_URL=http://localhost:4000
# 32-byte key for encrypting card tokens and 2FA secrets: openssl rand -hex 32 (required in production)
DATA_ENCRYPTION_KEY=

# Payments. fake = built-in test checkout (dev only). Use paystack in staging/production.
PAYMENTS_PROVIDER=fake
PAYSTACK_SECRET_KEY=
# Webhook URL to set in the Paystack dashboard: <PUBLIC_API_URL>/v1/webhooks/paystack
PAYMENT_EMAIL_DOMAIN=riders.zuma.ng
# Withdrawals at or below this (kobo) are approved and sent automatically. 0 = finance approves every payout.
PAYOUT_AUTO_APPROVE_MAX_KOBO=0

# Files (driver documents, chat photos). local = ./.uploads (dev only). s3 works with Cloudflare R2 or AWS S3.
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Drivers and vehicles can only be approved once their documents are approved.
DRIVER_DOCS_REQUIRED=true

# Push. console = log only (dev). expo = Expo push service (FCM/APNs).
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=
CHAT_OPEN_AFTER_TRIP_S=3600

REFERRAL_REWARD_PASSENGER_KOBO=50000
REFERRAL_REWARD_DRIVER_KOBO=200000
REFERRAL_DRIVER_TRIPS=10

# Authenticator-app 2FA for admins. Defaults to true in production.
ADMIN_2FA_REQUIRED=false
