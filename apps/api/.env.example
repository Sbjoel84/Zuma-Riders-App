NODE_ENV=development
PORT=4000
# Neon pooled connection string in staging/production
DATABASE_URL=postgresql://zuma:zuma@localhost:5432/zuma_dev
REDIS_URL=redis://localhost:6379
# Generate each with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
OTP_SECRET=change-me-change-me-change-me-change-me
TRIP_PIN_SECRET=change-me-change-me-change-me-change-me
# console prints OTPs to the API log (dev only). Use termii in staging/production.
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=Zuma
# estimate = straight line x 1.35 (dev only). Use google in staging/production.
MAPS_PROVIDER=estimate
GOOGLE_MAPS_API_KEY=
WORKER_ENABLED=true
MATCH_EXPAND_AFTER_S=15
EARNINGS_HOLD_S=86400
DRIVER_NEGATIVE_LIMIT_KOBO=500000
CORS_ORIGINS=*
