# Your machine's LAN IP when testing on a phone, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Android Maps SDK key (restricted to com.zuma.passenger). iOS uses Apple Maps.
GOOGLE_MAPS_ANDROID_KEY=
# EAS project id (from `eas init`); needed for push notifications on real devices.
EAS_PROJECT_ID=
