// =============================================================================
// Ride-hailing platform — PostgreSQL schema (Prisma)
// Phase 1 deliverable. See docs/DECISIONS.md for the reasoning behind
// money representation, the ledger, ride locking and entity merges.
//
// Conventions
//  - IDs: cuid() strings. Public-facing references (ride codes, payment refs)
//    are separate human-readable columns.
//  - Money: BigInt in KOBO (minor units). Never Float/Decimal for balances.
//  - Time: timestamptz everywhere (@db.Timestamptz(3)).
//  - Geo: PostGIS geography(Point,4326) for anything queried spatially; plain
//    lat/lng doubles kept alongside for app convenience.
//  - Soft delete: deletedAt on user-owned, non-financial records only.
//    Financial and completed-trip records are never deleted (onDelete: Restrict).
// =============================================================================

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/client"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

// Connection URLs live in prisma.config.ts (Prisma 7). Runtime uses @prisma/adapter-pg.
datasource db {
  provider   = "postgresql"
  extensions = [postgis, citext, pgcrypto]
}

