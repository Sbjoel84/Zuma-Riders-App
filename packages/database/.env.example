# Local development (docker compose up -d)
DATABASE_URL="postgresql://zuma:zuma@localhost:5432/zuma_dev"
DIRECT_DATABASE_URL="postgresql://zuma:zuma@localhost:5432/zuma_dev"

# Staging/production on Neon:
#   DATABASE_URL        = pooled connection (host ends in -pooler), used by the API at runtime
#   DIRECT_DATABASE_URL = direct connection, used by migrations
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/zuma?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/zuma?sslmode=require"
